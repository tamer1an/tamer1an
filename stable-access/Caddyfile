# Both upstreams bind to loopback and reject a foreign Host header (agent-bank: 421 "bad host",
# Ollama: 403), as a DNS-rebinding guard. This proxy must rewrite Host to get past that guard, so it
# re-imposes it first: only the tailnet name (short or MagicDNS FQDN) or a tailnet IP may come
# through. A rebinding page on this machine sends its own domain and gets 421. agent-bank still
# requires x-bank-token.
{
	admin off
	auto_https off
}

(tailnet_only) {
	@foreign not header_regexp Host (?i)^({$TS_HOSTNAME}(\.[a-z0-9-]+\.ts\.net)?|100\.\d+\.\d+\.\d+|\[fd7a:115c:a1e0:[0-9a-f:]+\])(:\d+)?$
	respond @foreign "bad host" 421
}

http://:17077 {
	bind 127.0.0.1
	import tailnet_only
	reverse_proxy 127.0.0.1:{$BANK_PORT} {
		header_up Host 127.0.0.1:{$BANK_PORT}
	}
}

http://:21434 {
	bind 127.0.0.1
	import tailnet_only
	reverse_proxy 127.0.0.1:{$OLLAMA_PORT} {
		header_up Host localhost:{$OLLAMA_PORT}
		flush_interval -1 # stream tokens as they arrive
	}
}
